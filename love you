@Composable
fun MainContainer() {
    // 界面状态：boot -> confession -> note
    var screenState by remember { mutableStateOf("boot") }

    Box(modifier = Modifier.fillMaxSize().background(Color.Black)) {
        when (screenState) {
            "boot" -> {
                BootScreen(onFinished = { screenState = "confession" })
            }
            "confession" -> {
                ConfessionScreen(onFinished = { screenState = "note" })
            }
            "note" -> {
                NoteScreen()
            }
        }
    }
}

@Composable
fun BootScreen(onFinished: () -> Unit) {
    val pathCode = "你自己的名字，70行/ Heart/ 你自己的名字 the whole world"
    var displayedText by remember { mutableStateOf("") }
    val greenColor = Color(0xFF00FF00)

    LaunchedEffect(Unit) {
        delay(1000)
        val lines = listOf(
            "> Initializing boot sequence...",
            "> Connection secure.",
            "> Accessing path: $pathCode",
            "> System ready. Starting heart.app..."
        )

        for (line in lines) {
            val currentLine = displayedText
            for (i in line.indices) {
                displayedText = currentLine + line.substring(0, i + 1)
                delay(40)
            }
            displayedText += "\n"
            delay(400)
        }
        delay(1000)
        onFinished()
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .padding(32.dp),
        contentAlignment = Alignment.CenterStart
    ) {
        Text(
            text = displayedText,
            color = greenColor,
            fontSize = 18.sp,
            fontFamily = FontFamily.Monospace,
            lineHeight = 28.sp
        )
    }
}

@Composable
fun ConfessionScreen(onFinished: () -> Unit) {
    val messages = remember {
        listOf(
            "记得吃早餐", "多喝热水呀", "别熬夜太晚", "你是最棒的", "想你了呀",
            "今天辛苦了", "注意保暖哦", "你是我的光", "开心每一天", "遇见你真好",
            "要按时吃饭", "梦里见哦", "为你骄傲", "你是唯一的", "加油鸭！",
            "照顾好自己", "早点休息哈", "你是最可爱", "心动不止", "一直都在",
            "愿你顺心", "你是宝藏", "多笑笑哦", "好梦相随", "你是动力",
            "爱你么么哒", "你是奇迹", "温暖如你", "你是骄傲", "平安喜乐",
            "你最闪耀", "你是依靠", "万事胜意", "你是未来", "共度余生",
            "你是星辰", "你是大海", "你是全部", "你是我唯一", "爱你永远",
            "记得想我", "保持联系", "你是阳光", "你是月亮", "你是繁星",
            "爱你如初", "你是宝贝", "你是最美", "你是最好的", "爱你不停",
            "你是归宿", "你是梦想"
        )
    }

    val macStickyColors = listOf(
        Color(0xFFFFFBBD), Color(0xFFE3F9B9), Color(0xFFB9F2FF),
        Color(0xFFFFD1FB), Color(0xFFFFD7B9)
    )

    val totalNotes = 52
    val scale = 10f

    var notesAnimationStarted by remember { mutableStateOf(false) }
    var textAnimationStarted by remember { mutableStateOf(false) }

    val noteData = remember {
        (0 until totalNotes).map { i ->
            val t = (2 * PI * i) / totalNotes
            val x = 16 * sin(t).pow(3.0)
            val y = -(13 * cos(t) - 5 * cos(2 * t) - 2 * cos(3 * t) - cos(4 * t))
            Triple(x.toFloat(), y.toFloat(), i)
        }.sortedWith(compareBy({ it.second }, { it.first }))
    }

    LaunchedEffect(Unit) {
        delay(300)
        notesAnimationStarted = true
        delay(totalNotes * 40L + 1000L)
        textAnimationStarted = true
        // 文字显示完后延迟进入下一页
        delay(4000)
        onFinished()
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.Black),
        contentAlignment = Alignment.Center
    ) {
        noteData.forEachIndexed { index, (x, y, originalIndex) ->
            val animatedProgress = animateFloatAsState(
                targetValue = if (notesAnimationStarted) 1f else 0f,
                animationSpec = tween(durationMillis = 800, delayMillis = index * 40, easing = EaseOutBack),
                label = "note_$index"
            )

            MacStickyNote(
                message = messages[originalIndex % messages.size],
                color = macStickyColors[originalIndex % macStickyColors.size],
                rotation = (originalIndex * 13f) % 20f - 10f,
                modifier = Modifier
                    .offset(x = (x * scale * animatedProgress.value).dp, y = (y * scale * animatedProgress.value).dp)
                    .graphicsLayer {
                        alpha = animatedProgress.value
                        scaleX = animatedProgress.value.coerceAtLeast(0.1f)
                        scaleY = animatedProgress.value.coerceAtLeast(0.1f)
                    }
            )
        }

        Column(
            modifier = Modifier.offset(y = 30.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Row {
                "请写上你爱人的名字，定位在192行".forEachIndexed { index, char ->
                    FlipTextChar(char = char, trigger = textAnimationStarted, delayMillis = index * 300, fontSize = 24.sp)
                }
            }
            Spacer(modifier = Modifier.height(6.dp))
            Row {
                "我爱你".forEachIndexed { index, char ->
                    FlipTextChar(char = char, trigger = textAnimationStarted, delayMillis = 900 + index * 300, fontSize = 18.sp)
                }
            }
        }
    }
}

