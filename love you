@Composable
fun FlipTextChar(char: Char, trigger: Boolean, delayMillis: Int, fontSize: androidx.compose.ui.unit.TextUnit) {
    val rotationX = animateFloatAsState(
        targetValue = if (trigger) 0f else -90f,
        animationSpec = tween(
            durationMillis = 600,
            delayMillis = delayMillis,
            easing = FastOutSlowInEasing
        ),
        label = "flip_$char"
    )

    val alpha = animateFloatAsState(
        targetValue = if (trigger) 1f else 0f,
        animationSpec = tween(
            durationMillis = 300,
            delayMillis = delayMillis
        ),
        label = "alpha_$char"
    )

    Box(
        modifier = Modifier
            .padding(horizontal = 2.dp)
            .graphicsLayer {
                this.rotationX = rotationX.value
                cameraDistance = 12f * density
            }
            .background(
                if (alpha.value > 0.1f) Color(0xFF222222) else Color.Transparent,
                RoundedCornerShape(4.dp)
            )
            .padding(horizontal = 6.dp, vertical = 4.dp),
        contentAlignment = Alignment.Center
    ) {
        Text(
            text = char.toString(),
            color = Color.White,
            fontSize = fontSize,
            fontWeight = FontWeight.Bold,
            modifier = Modifier.graphicsLayer { this.alpha = alpha.value }
        )
    }
}

@Composable
fun MacStickyNote(message: String, color: Color, rotation: Float, modifier: Modifier = Modifier) {
    Surface(
        modifier = modifier
            .size(34.dp)
            .rotate(rotation),
        color = color,
        shape = RoundedCornerShape(1.dp),
        shadowElevation = 1.dp
    ) {
        Column {
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(4.dp)
                    .background(color.copy(alpha = 0.6f))
            )
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(1.dp),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = message,
                    color = Color.Black.copy(alpha = 0.8f),
                    fontSize = 7.sp,
                    fontWeight = FontWeight.Bold,
                    lineHeight = 9.sp,
                    textAlign = TextAlign.Center
                )
            }
        }
    }
}

